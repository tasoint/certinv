{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"showHeader": true},
      "targets": [
        {"expr": "certinv_cert_remaining_ratio", "format": "table", "refId": "A"}
      ],
      "title": "Certificate remaining ratio",
      "type": "table"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {"unit": "d"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"showHeader": true},
      "targets": [
        {"expr": "(certinv_cert_not_after_timestamp - time()) / 86400", "format": "table", "refId": "A"}
      ],
      "title": "Certificate days remaining",
      "type": "table"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8},
      "id": 3,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto"},
      "targets": [
        {"expr": "certinv_host_reachable", "format": "time_series", "refId": "A"}
      ],
      "title": "Host reachability",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 8},
      "id": 4,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto"},
      "targets": [
        {"expr": "certinv_scan_duration_seconds", "refId": "A"}
      ],
      "title": "Last scan duration",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {"unit": "dateTimeAsIso"},
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 8},
      "id": 5,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto"},
      "targets": [
        {"expr": "certinv_scan_last_success_timestamp", "refId": "A"}
      ],
      "title": "Last successful scan",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["certinv", "prometheus"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Prometheus",
        "name": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "title": "certinv",
  "uid": "certinv",
  "version": 1
}
